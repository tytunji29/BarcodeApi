
@model BarcodeApi.MVC.CerpacViewModel
@{
    Layout = null;
    var qrData = ViewBag.QrCodeData as string ?? "#";
    var appId = ViewBag.ApplicationId as string ?? "NIS/CERPAC/2025/04289";
    var permitType = ViewBag.Type as string ?? "cerpac";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>NIS e-CERPAC | @Model.FullName - Resident Permit Details</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/antd/5.21.6/reset.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/antd/5.21.6/antd.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', system-ui, 'Plus Jakarta Sans', sans-serif; background: #f8fafc; }
        .skeleton-pulse { background: linear-gradient(90deg, #e2e8f0 25%, #f1f5f9 37%, #e2e8f0 63%); background-size: 400% 100%; animation: pulse-loading 1.4s ease infinite; border-radius: 0.375rem; }
        @@keyframes pulse-loading { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }
        .nis-gradient { background: linear-gradient(135deg, #0f973d 0%, #0b7a3a 100%); }
    </style>
    <style>
.ant-tag.ant-tag-magenta{
    color: #c41d7f;
    background: #fff0f6;
    border: 1px solid #ffadd2;
    padding: 4px 14px;
    border-radius: 40px;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 500;
    display: inline-block;
}
.ant-tag.ant-tag-orange {
    color: #d46b08;
    background: #fff7e6;
    border: 1px solid #ffd591;
    padding: 4px 14px;
    border-radius: 40px;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 500;
    display: inline-block;
}
</style>
</head>
<body class="min-h-screen bg-gray-50 antialiased">
    <main class="max-w-4xl mx-auto px-4 py-6 md:py-10 lg:px-6">
        <div class="space-y-5">
            <!-- Header with dynamic logo and app context -->
          <div class="flex items-center justify-between">
    
    <a class="flex items-center justify-center text-[#08784b]" href="/">
        
        <img alt="cerpac logo"
             loading="lazy"
             width="140"
             height="47"
             class="block"
             src="data:image/png;base64," />

        <span class="-ml-0.5 hidden text-lg font-semibold lg:block">
            | e-CERPAC
        </span>

    </a>

    <p class="font-semibold">e-CERPAC</p>

</div>
<header class="relative my-6 flex h-full w-full flex-col items-start justify-between gap-y-6 overflow-hidden rounded-none border bg-zinc-50 p-4 md:rounded-2xl lg:p-8 xl:flex-row">
    <div class="flex flex-wrap items-center gap-4">
        <div class="flex items-center justify-center text-3xl text-gray-700 z-10 rounded-xl border bg-white md:rounded-full" style="width: 130px; height: 130px;">
           
                <img alt="@Model.ProfileInitials"
             loading="lazy"
             width="140"
             height="47"
             class="block"
             src="data:image/png;base64,@Model.Picture" />

            </div>
        <div class="flex flex-col gap-1"><div><span class="ant-tag ant-tag-magenta uppercase css-ze28cf" style="border-radius: 40px;">Expatriate</span>
        
        <h1 class="mt-1 text-xl font-semibold text-zinc-800 md:text-2xl">@Model.FullName</h1></div></div><div class="pointer-events-none"><div class="mask-[linear-gradient(white,transparent)] absolute inset-0 rounded-2xl transition duration-300 group-hover:opacity-50"><svg aria-hidden="true" class="dark:fillWhite/1 dark:strokeWhite/2.5 absolute inset-x-0 inset-y-[-30%] h-[160%] w-full skew-y-[-18deg] fill-black/[0.02] stroke-black/5"><defs><pattern id=":Rkq5jsqja:" width="72" height="56" patternUnits="userSpaceOnUse" x="50%" y="16"><path d="M.5 56V.5H72" fill="none"></path></pattern></defs><rect width="100%" height="100%" stroke-width="0" fill="url(#:Rkq5jsqja:)"></rect><svg x="50%" y="16" class="overflow-visible"><rect stroke-width="0" width="73" height="57" x="0" y="56"></rect><rect stroke-width="0" width="73" height="57" x="72" y="168"></rect></svg></svg></div><div class="bg-linear-to-r absolute inset-0 rounded-2xl from-[#D7EDEA] to-[#F4FBDF] opacity-0 transition duration-300 group-hover:opacity-100 dark:from-[#202D2E] dark:to-[#303428]" style="mask-image: radial-gradient(180px at 238.5px 101px, white, transparent);"></div>
        <div class="absolute inset-0 rounded-2xl opacity-0 mix-blend-overlay transition duration-300 group-hover:opacity-100" style="mask-image: radial-gradient(180px at 238.5px 101px, white, transparent);"><svg aria-hidden="true" class="dark:fillWhite/2.5 dark:strokeWhite/10 absolute inset-x-0 inset-y-[-30%] h-[160%] w-full skew-y-[-18deg] fill-black/50 stroke-black/70"><defs><pattern id=":R5kq5jsqja:" width="72" height="56" patternUnits="userSpaceOnUse" x="50%" y="16"><path d="M.5 56V.5H72" fill="none"></path></pattern></defs><rect width="100%" height="100%" stroke-width="0" fill="url(#:R5kq5jsqja:)"></rect><svg x="50%" y="16" class="overflow-visible"><rect stroke-width="0" width="73" height="57" x="0" y="56"></rect><rect stroke-width="0" width="73" height="57" x="72" y="168"></rect></svg></svg></div></div></div><div class="flex flex-col"><p class="pb-0.5 text-left text-xs font-light tracking-wide text-muted xl:text-end">e-CERPAC Number</p><button type="button" class="flex items-center gap-1 flex-row-reverse"><p class="font-mono text-lg font-semibold text-zinc-700 xl:text-xl">@Model.CerpacNumber</p> <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-5 text-muted"><path d="M16 12.9V17.1C16 20.6 14.6 22 11.1 22H6.9C3.4 22 2 20.6 2 17.1V12.9C2 9.4 3.4 8 6.9 8H11.1C14.6 8 16 9.4 16 12.9Z" stroke="#777777" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M22 6.9V11.1C22 14.6 20.6 16 17.1 16H16V12.9C16 9.4 14.6 8 11.1 8H8V6.9C8 3.4 9.4 2 12.9 2H17.1C20.6 2 22 3.4 22 6.9Z" stroke="#777777" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button><div class="mt-2 flex self-end"><span class="ant-tag ant-tag-orange uppercase css-ze28cf">Active</span></div></div></header>
        

            <!-- PERSONAL INFORMATION (dynamically bound) -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="border-b bg-zinc-50 px-6 py-4"><span class="transition-colors text-black text-[14.6px] font-semibold flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user size-4"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg> Personal Information</span></div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-y-5 gap-x-8 p-6">
                    <div><div class="text-xs font-medium text-gray-400 uppercase tracking-wide">e-CERPAC Number</div><div class="text-gray-800 font-medium mt-1">@Model.CerpacNumber</div></div>
                    <div><div class="text-xs font-medium text-gray-400 uppercase tracking-wide">Date of Expiry</div><div class="text-gray-800 font-medium mt-1">@Model.ExpiryDate</div></div>
                    <div><div class="text-xs font-medium text-gray-400 uppercase tracking-wide">Passport Number</div><div class="text-gray-800 font-medium mt-1">@Model.PassportNumber</div></div>
                    <div><div class="text-xs font-medium text-gray-400 uppercase tracking-wide">First Name</div><div class="text-gray-800 font-medium mt-1">@Model.FirstName</div></div>
                    <div><div class="text-xs font-medium text-gray-400 uppercase tracking-wide">Middle Name</div><div class="text-gray-800 font-medium mt-1">@Model.MiddleName</div></div>
                    <div><div class="text-xs font-medium text-gray-400 uppercase tracking-wide">Last Name</div><div class="text-gray-800 font-medium mt-1">@Model.LastName</div></div>
                    <div><div class="text-xs font-medium text-gray-400 uppercase tracking-wide">Date of Birth</div><div class="text-gray-800 font-medium mt-1">@Model.DateOfBirth</div></div>
                    <div><div class="text-xs font-medium text-gray-400 uppercase tracking-wide">Sex</div><div class="text-gray-800 font-medium mt-1">@Model.Gender</div></div>
                   <div class="text-xs font-medium text-gray-400 uppercase tracking-wide">Nationality
                    <div class="text-gray-800 font-medium mt-1 flex items-center gap-2">
    <img alt="@Model.Nationality"
         loading="lazy"
         width="16"
         height="16"
         decoding="async"
         data-nimg="1"
         class="min-h-4 min-w-4 rounded-full border bg-zinc-100"
        
         src="https://flagcdn.com/h60/@(Model.CountryInitial).png"
         style="color: transparent;" />

    <span>@Model.Nationality</span>
</div></div>
                    <div><div class="text-xs font-medium text-gray-400 uppercase tracking-wide">Validity</div><div class="text-gray-800 font-medium mt-1">@Model.IssueDate - @Model.ExpiryDate</div></div>
                    <div><div class="text-xs font-medium text-gray-400 uppercase tracking-wide">Resident Class</div><div class="text-gray-800 font-medium mt-1">Expatriate</div></div>
                </div>
            </div>
<div class="overflow-hidden rounded-none border md:rounded-2xl"><div class="border-b bg-zinc-50 px-6 py-4"><span class="transition-colors text-black text-[14.6px] font-semibold flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase size-4"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path><rect width="20" height="14" x="2" y="6" rx="2"></rect></svg> Employment Information</span></div><div class="grid grid-cols-1 gap-6 p-6 md:grid-cols-2">
    <div class="flex flex-col last:border-b-0"><span class="transition-colors mb-1 text-xs font-medium text-slate-500">Company Name</span><span class="transition-colors text-[14.6px] font-normal text-slate-900">@Model.CompanyName</span></div><div class="flex flex-col last:border-b-0"><span class="transition-colors mb-1 text-xs font-medium text-slate-500">Company RC Number</span><span class="transition-colors text-[14.6px] font-normal text-slate-900">@Model.CompanyRCNumber</span></div><div class="flex flex-col last:border-b-0 md:col-span-2"><span class="transition-colors mb-1 text-xs font-medium text-slate-500">Company Registered Address</span><span class="transition-colors text-[14.6px] font-normal text-slate-900">@Model.CompanyRegisteredAddress</span></div><div class="flex flex-col last:border-b-0"><span class="transition-colors mb-1 text-xs font-medium text-slate-500">Company Telephone</span><span class="transition-colors text-[14.6px] font-normal text-slate-900">@Model.CompanyTelephone</span></div><div class="flex flex-col last:border-b-0"><span class="transition-colors mb-1 text-xs font-medium text-slate-500">Company Email</span><span class="transition-colors text-[14.6px] font-normal text-slate-900">@Model.CompanyEmail</span></div><div class="flex flex-col last:border-b-0"><span class="transition-colors mb-1 text-xs font-medium text-slate-500">Designation</span><span class="transition-colors text-[14.6px] font-normal text-slate-900">@Model.Designation</span></div></div></div>
          
        </div>
    </main>
 
    <script>
        // Optional interactive alert for QR
        document.querySelector('.cursor-pointer')?.addEventListener('click', function(e) {
            alert('Official QR verification data: @qrData');
        });
    </script>
</body>
</html>